# Never commit real credentials. Copy this file to backend/.env.
GEMINI_API_KEY=
AI_PROVIDER=yandex
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
SEARCH_API_KEY=
SEARCH_API_KEY_FALLBACK=

# Gemini 1.5 Flash was shut down in September 2025. This is its current
# low-latency replacement; the value remains configurable.
GEMINI_MODEL=gemini-3.5-flash-lite
YANDEX_MODEL=yandexgpt

# The built-in image-search adapter targets Serper's image endpoint.
SEARCH_API_URL=https://google.serper.dev/images
SEARCH_RESULTS_PER_QUERY=10

# Identify your application and include a monitored contact address.
# This is required by the public Nominatim usage policy.
NOMINATIM_USER_AGENT=WhirlpoolCampusProfiler/1.0 (contact: you@example.com)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://whirlpool-campus-profiler.rozasadykovas.chatgpt.site
PIPELINE_TIMEOUT_SECONDS=29
MAX_IMAGES=16
